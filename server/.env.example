# ---- Server config ----
SERVER_ADDR=:8080
SERVER_MODE=debug

# ---- Meta DB (users/groups/connections) ----
# Driver selects which engine stores Chat2DB's own metadata.
# Supported: sqlite | postgres | mysql
META_DB_DRIVER=sqlite

# Used only when META_DB_DRIVER=sqlite. Ignored otherwise.
META_DB_PATH=./data/chat2db.db

# Used when META_DB_DRIVER=postgres or mysql. Examples:
#   postgres: postgres://chat2db:secret@127.0.0.1:5432/chat2db?sslmode=disable
#   mysql:    chat2db:secret@tcp(127.0.0.1:3306)/chat2db?parseTime=true&loc=Local&charset=utf8mb4&collation=utf8mb4_bin
# META_DB_DSN=

# Pool tuning (all drivers; sane defaults if omitted)
# META_DB_MAX_OPEN_CONNS=25
# META_DB_MAX_IDLE_CONNS=5
# META_DB_CONN_MAX_LIFETIME=30m

# Run pending SQL migrations on boot. Set to false in production once you
# operate migrations out-of-band via the golang-migrate CLI.
META_DB_AUTO_MIGRATE=true

# JWT
JWT_SECRET=please-change-me-in-production
JWT_EXPIRE_HOURS=72

# AES-GCM key used to encrypt stored DB passwords and LLM API keys.
# MUST be 32 bytes (base64 or raw). For dev, use any 32-char string.
CREDENTIAL_KEY=0123456789abcdef0123456789abcdef

# Query execution limits
QUERY_MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=30
